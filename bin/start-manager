#!/usr/bin/env bash

set -Eeuo pipefail

PROJECT="/opt/zero2w-manager"
PYTHON="$PROJECT/venv/bin/python3"
LOCK_FILE="$PROJECT/runtime/manager.lock"

mkdir -p "$PROJECT/runtime"

exec 9>"$LOCK_FILE"

if ! flock -n 9; then
    echo "Zero2W Manager is already running."
    exit 1
fi

cd "$PROJECT"

export PYTHONPATH="$PROJECT"

echo "Recovering stale runtime state..."

"$PYTHON" -m tools.runtime_recovery

echo "Removing abandoned managed applications..."

pkill -TERM -f '/opt/ragnar/app/Ragnar.py'     2>/dev/null || true

echo "Removing abandoned Diagnostics processes..."

pkill -TERM -f 'apps\.run_diagnostics_overlay' \
    2>/dev/null || true

pkill -TERM -f 'apps\.diagnostic' \
    2>/dev/null || true

sleep 1

pkill -KILL -f 'apps\.run_diagnostics_overlay' \
    2>/dev/null || true

pkill -KILL -f 'apps\.diagnostic' \
    2>/dev/null || true

pkill -KILL -f '/opt/ragnar/app/Ragnar.py' \
    2>/dev/null || true

echo "Starting Zero2W Manager..."

exec "$PYTHON" -m manager.daemon
